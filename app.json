{
  "expo": {
    "name": "FOX PLAYER",
    "slug": "fox-player",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "scheme": "foxplayer",
    "newArchEnabled": true,
    "platforms": [
      "ios",
      "android"
    ],
    "androidStatusBar": {
      "hidden": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foxplayer.app",
      "requireFullScreen": true,
      "userInterfaceStyle": "dark",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsArbitraryLoadsForMedia": true
        },
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIStatusBarHidden": true,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "backgroundColor": "#000000",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "package": "com.foxplayer.iptv.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "expo-secure-store",
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-screen-orientation",
      "./plugins/withExpoScreenOrientationIosFix",
      "./plugins/withFoxSubtitleFontSize",
      "./plugins/withFoxVlcSubtitleFontSize",
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#000000",
          "style": "light"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/app-logo.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "largeHeap": true,
            "minSdkVersion": 24,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libvlc.so",
                "**/libvlcjni.so"
              ]
            },
            "enableMinifyInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withVlcKit",
      "expo-image",
      "expo-brightness"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false,
        "root": "src/app"
      },
      "expo-navigation-bar": {
        "style": "light"
      },
      "eas": {
        "projectId": "9a39bb62-5733-4f8d-b594-24385d9e26be"
      }
    }
  }
}
